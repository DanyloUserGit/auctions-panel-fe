# ===== Фронтенд (Vite). Скопіюйте у .env і заповніть; значення вбудовуються під час npm run build. =====

# Адреса API (без /api в кінці)
VITE_API_URL=https://api.panel.caddyluck.com.ua

# Капча на вході (Cloudflare Turnstile) - публічний ключ сайту
VITE_TURNSTILE_SITE_KEY=CHANGE_ME

# ICE-сервери трансляції (через кому) - ті самі, що WEBRTC_* у воркера
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
VITE_TURN_USERNAME=CHANGE_ME
VITE_TURN_CREDENTIAL=CHANGE_ME
